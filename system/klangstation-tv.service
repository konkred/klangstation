# "Laeuft gerade"-Bildschirm auf Systemen ohne Desktop (Raspberry Pi OS Lite & Co.).
# Nur mit: sudo ./install.sh --tv-headless   (installiert cage und chromium)
[Unit]
Description=Klangstation Laeuft-gerade-Bildschirm (Kiosk ohne Desktop)
After=klangstation.service systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
User=klangstation
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# -m last: nur der zuletzt angeschlossene Bildschirm (Laptop mit Fernseher: ganz auf den Fernseher statt ueber beide verteilt)
ExecStart=/usr/bin/cage -s -m last -- /opt/klangstation/system/ks-tv-kiosk
Restart=always
RestartSec=5
# cage blockiert SIGTERM fuer sich (signalfd) und vererbt die Sperre an das Kiosk-Skript; nach SIGTERM wartet
# cage, bis das Skript endet - ohne das bis zum harten Abbruch nach 90 s. Also zuerst das Skript beenden.
ExecStop=-/usr/bin/pkill -KILL -x -u klangstation ks-tv-kiosk
TimeoutStopSec=10

[Install]
# multi-user: Systeme ohne Desktop starten graphical.target gar nicht
WantedBy=multi-user.target
