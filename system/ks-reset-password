#!/bin/sh
# Entfernt den Zugangsschutz der Weboberflaeche (vergessenes Passwort). Als root ausfuehren:
#   sudo /opt/klangstation/system/ks-reset-password
set -e
[ "$(id -u)" -eq 0 ] || { echo "Bitte mit sudo ausfuehren." >&2; exit 1; }
# Dienst anhalten, damit er die Einstellungen nicht gleichzeitig ueberschreibt
systemctl stop klangstation
cd /opt/klangstation/backend
runuser -u klangstation -- env KS_DATA_DIR=/var/lib/klangstation /opt/klangstation/venv/bin/python -m klangstation --reset-password
systemctl start klangstation
